@model List<ADSimulator.Data.ADUser>
@{ ViewData["Title"] = "Users"; }

<div class="win-panel">
    <div class="win-panel-head">
        <span class="win-panel-title">👥 All User Accounts (@Model.Count)</span>
        <div class="d-flex gap-2">
            <form method="get" class="search-wrap">
                <div class="search-box">
                    <span>🔍</span>
                    <input name="search" placeholder="Search users..." value="@ViewBag.Search" />
                </div>
                <select name="ouId" class="form-control" style="width:140px; padding:3px 6px;">
                    <option value="">All OUs</option>
                    @foreach (var ou in (List<ADSimulator.Data.OrganizationalUnit>)ViewBag.OUs)
                    {
                        <option value="@ou.Id" @(ViewBag.OUId == ou.Id ? "selected" : "")>@ou.Name</option>
                    }
                </select>
                <button type="submit" class="btn btn-default btn-sm">Filter</button>
                @if (ViewBag.Search != null || ViewBag.OUId != null)
                {
                    <a href="/Users" class="btn btn-default btn-sm">Clear</a>
                }
            </form>
            <a href="/Users/Create" class="btn btn-primary btn-sm">➕ New User</a>
        </div>
    </div>
    <div class="win-panel-body">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-ico">👤</div>
                <div>No users found</div>
                <a href="/Users/Create" class="btn btn-primary" style="margin-top:8px;">Create First User</a>
            </div>
        }
        else
        {
            <table class="win-table">
                <thead>
                    <tr>
                        <th>👤 Username</th>
                        <th>Full Name</th>
                        <th>Email Address</th>
                        <th>Org. Unit</th>
                        <th>Account Status</th>
                        <th>Failed Attempts</th>
                        <th>Last Logon</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td style="font-weight:600; color:var(--blue);">
                            <a href="/Users/Details/@user.Id" style="color:var(--blue);text-decoration:none;">👤 @user.Username</a>
                        </td>
                        <td>@user.FullName</td>
                        <td class="text-muted">@user.Email</td>
                        <td><span class="badge badge-ou">@user.OU?.Name</span></td>
                        <td>
                            @if (user.IsLocked) { <span class="badge badge-lock">🔒 Locked Out</span> }
                            else if (!user.IsEnabled) { <span class="badge badge-dis">🚫 Disabled</span> }
                            else { <span class="badge badge-ok">✅ Active</span> }
                        </td>
                        <td style="text-align:center;">
                            <span style="color:@(user.FailedLoginAttempts >= 3 ? "var(--red)" : user.FailedLoginAttempts > 0 ? "var(--orange)" : "var(--green)")">
                                @user.FailedLoginAttempts / 3
                            </span>
                        </td>
                        <td class="text-muted">@(user.LastLogin.HasValue ? user.LastLogin.Value.ToString("MMM dd, HH:mm") : "Never")</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a href="/Users/Details/@user.Id" class="btn btn-default btn-sm">Properties</a>
                                <form method="post" action="/Users/Delete/@user.Id" onsubmit="return confirm('Delete user @user.Username?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
