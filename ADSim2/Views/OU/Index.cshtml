@model List<ADSimulator.Data.OrganizationalUnit>
@{ ViewData["Title"] = "Organizational Units"; }

<div class="win-panel">
    <div class="win-panel-head">
        <span class="win-panel-title">🗂️ Organizational Units (@Model.Count)</span>
        <a href="/OU/Create" class="btn btn-primary btn-sm">+ New OU</a>
    </div>
    <div class="win-panel-body">
        @if (!Model.Any())
        {
            <div class="empty-state"><div class="empty-ico">🗂️</div><div>No OUs created yet</div><a href="/OU/Create" class="btn btn-primary" style="margin-top:8px;">Create OU</a></div>
        }
        else
        {
            <table class="win-table">
                <thead><tr><th>🗂️ Name</th><th>Description</th><th>Users</th><th>Created</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var ou in Model)
                {
                    <tr>
                        <td><a href="/OU/Details/@ou.Id" style="color:var(--blue);text-decoration:none;font-weight:600;">🗂️ @ou.Name</a></td>
                        <td class="text-muted">@(string.IsNullOrEmpty(ou.Description) ? "—" : ou.Description)</td>
                        <td><a href="/Users?ouId=@ou.Id" style="text-decoration:none;"><span class="badge badge-ou">@ou.Users.Count user(s)</span></a></td>
                        <td class="text-muted">@ou.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a href="/OU/Details/@ou.Id" class="btn btn-default btn-sm">Properties</a>
                                <a href="/OU/Edit/@ou.Id" class="btn btn-default btn-sm">Edit</a>
                                <form method="post" action="/OU/Delete/@ou.Id" onsubmit="return confirm('Delete OU @ou.Name and all its users?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
