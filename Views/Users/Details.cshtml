@model ADSimulator.Data.ADUser
@{ ViewData["Title"] = Model.Username + " Properties"; }

<div class="panel-hdr">
    <div class="panel-hdr-title"><span class="phi">👤</span> @Model.Username — User Properties</div>
    <div class="panel-hdr-actions">
        <a href="/Users/Edit/@Model.Id" class="btn btn-default btn-sm">✏️ Edit</a>
        <a href="/Users" class="btn btn-default btn-sm">← Back</a>
        <form method="post" action="/Users/Delete/@Model.Id" style="display:inline;" onsubmit="return confirm('Delete user @Model.Username?')">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger btn-sm">🗑️ Delete</button>
        </form>
    </div>
</div>

<div class="detail-pane">
    <!-- Left: Avatar + Quick Actions -->
    <div class="detail-left">
        <div class="detail-avatar">
            <div class="av-icon">
                @if (Model.IsLocked) { <text>🔒</text> }
                else if (!Model.IsEnabled) { <text>🚫</text> }
                else { <text>👤</text> }
            </div>
            <div class="av-name">@Model.FullName</div>
            <div class="av-user">@@@Model.Username</div>
            <div style="margin-top:8px;">
                @if (Model.IsLocked) { <span class="badge b-lock" style="font-size:12px; padding:3px 10px;">🔒 LOCKED OUT</span> }
                else if (!Model.IsEnabled) { <span class="badge b-dis" style="font-size:12px; padding:3px 10px;">🚫 DISABLED</span> }
                else { <span class="badge b-ok" style="font-size:12px; padding:3px 10px;">✅ ACTIVE</span> }
            </div>
        </div>

        <div class="section-title">Quick Actions</div>
        <div style="display:flex; flex-direction:column; gap:5px;">
            @if (Model.IsLocked)
            {
                <form method="post" action="/Users/Unlock/@Model.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success w100">🔓 Unlock Account</button>
                </form>
            }
            <form method="post" action="/Users/ToggleEnabled/@Model.Id">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn @(Model.IsEnabled ? "btn-warn" : "btn-success") w100">
                    @(Model.IsEnabled ? "🚫 Disable Account" : "✅ Enable Account")
                </button>
            </form>
            <a href="/Users/Edit/@Model.Id" class="btn btn-default w100">✏️ Edit Properties</a>
        </div>

        <div class="section-title" style="margin-top:14px;">Security Info</div>
        <table class="prop-table">
            <tr><td>Failed Logons</td><td><span class="badge @(Model.FailedLoginAttempts >= 3 ? "b-lock" : Model.FailedLoginAttempts > 0 ? "b-warn" : "b-ok")">@Model.FailedLoginAttempts / 3</span></td></tr>
            <tr><td>Locked</td><td>@(Model.IsLocked ? "🔒 Yes" : "✅ No")</td></tr>
            <tr><td>Enabled</td><td>@(Model.IsEnabled ? "✅ Yes" : "🚫 No")</td></tr>
        </table>
    </div>

    <!-- Right: Properties + Reset Password -->
    <div class="detail-right">
        <div class="section-title">Account Properties</div>
        <table class="prop-table">
            <tr><td>User ID</td><td>#@Model.Id</td></tr>
            <tr><td>Username</td><td style="font-weight:600;">@Model.Username</td></tr>
            <tr><td>Full Name</td><td>@Model.FullName</td></tr>
            <tr><td>Email</td><td>@Model.Email</td></tr>
            <tr><td>Org. Unit</td><td><a href="/OU/Details/@Model.OUId" style="color:#0078d4; text-decoration:none;">🗂️ @Model.OU?.Name</a></td></tr>
            <tr><td>Created</td><td>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</td></tr>
            <tr><td>Last Logon</td><td>@(Model.LastLogin.HasValue ? Model.LastLogin.Value.ToString("dd MMM yyyy HH:mm") : "Never")</td></tr>
        </table>

        <div class="section-title" style="margin-top:16px;">🔑 Reset Password</div>
        <div style="background:#fafafa; border:1px solid #e0e0e0; padding:12px;">
            <form method="post" action="/Users/ResetPassword/@Model.Id">
                @Html.AntiForgeryToken()
                <div class="form-row">
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">New Password <span style="color:#888; font-weight:400; font-size:10px;">(min 6)</span></label>
                        <input type="password" name="newPassword" class="form-control" placeholder="New password" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Confirm Password</label>
                        <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-sm" style="margin-top:8px;">🔑 Reset Password</button>
            </form>
        </div>
    </div>
</div>
