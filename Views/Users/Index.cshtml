@model List<ADSimulator.Data.ADUser>
@{ ViewData["Title"] = "Users"; }

<div class="panel-hdr">
    <div class="panel-hdr-title"><span class="phi">👥</span> Users (@Model.Count)</div>
    <div class="panel-hdr-actions">
        <a href="/Users/Create" class="btn btn-primary btn-sm">➕ New User</a>
    </div>
</div>

<div class="lv-toolbar">
    <form method="get" style="display:flex; gap:6px; align-items:center;">
        <div class="lv-search">
            <span>🔍</span>
            <input name="search" placeholder="Search users..." value="@ViewBag.Search" />
        </div>
        <div class="lv-filter">
            <select name="ouId">
                <option value="">All OUs</option>
                @foreach (var ou in (List<ADSimulator.Data.OrganizationalUnit>)ViewBag.OUs)
                {
                    <option value="@ou.Id" @(ViewBag.OUId == ou.Id ? "selected" : "")>@ou.Name</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-default btn-sm">Filter</button>
        @if (ViewBag.Search != null || ViewBag.OUId != null)
        {
            <a href="/Users" class="btn btn-default btn-sm">✕ Clear</a>
        }
    </form>
    <span class="lv-count">@Model.Count object(s)</span>
</div>

@if (!Model.Any())
{
    <div class="empty-state"><div class="es-icon">👤</div><p>No users found.</p></div>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Username</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Org. Unit</th>
                <th>Status</th>
                <th>Last Logon</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td><a href="/Users/Details/@u.Id" style="color:#0078d4; text-decoration:none; font-weight:600;">👤 @u.Username</a></td>
                <td>@u.FullName</td>
                <td style="color:#555;">@u.Email</td>
                <td><span class="badge b-info">@u.OU?.Name</span></td>
                <td>
                    @if (u.IsLocked) { <span class="badge b-lock">🔒 Locked</span> }
                    else if (!u.IsEnabled) { <span class="badge b-dis">🚫 Disabled</span> }
                    else { <span class="badge b-ok">✅ Active</span> }
                </td>
                <td style="color:#666; font-size:11px;">@(u.LastLogin.HasValue ? u.LastLogin.Value.ToString("dd MMM HH:mm") : "Never")</td>
                <td>
                    <div class="d-flex gap-1">
                        <a href="/Users/Details/@u.Id" class="btn btn-default btn-sm">Properties</a>
                        <a href="/Users/Edit/@u.Id" class="btn btn-default btn-sm">Edit</a>
                        <form method="post" action="/Users/Delete/@u.Id" style="display:inline;" onsubmit="return confirm('Delete user @u.Username?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
